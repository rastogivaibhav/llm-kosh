{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Koush Pack Source Map",
  "type": "object",
  "required": ["koush_id", "koush_version", "query", "matches"],
  "properties": {
    "koush_id": {
      "type": "string"
    },
    "koush_version": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "source_path", "pack_file", "included", "reason"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "project": { "type": "string" },
          "visibility": { "type": "string" },
          "status": { "type": "string" },
          "source_path": { "type": "string" },
          "pack_file": { "type": "string" },
          "included": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
